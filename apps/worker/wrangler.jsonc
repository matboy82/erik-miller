{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "erik-miller-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "CONVERSION_ENABLED": "false",
    "CONVERSION_OWNER_EMAIL": "millerremodelingidaho@gmail.com",
    "CONVERSION_OPERATOR_EMAIL": "millerremodelingidaho@gmail.com",
    "CONVERSION_PUBLIC_URL": "https://erik-miller-worker.matt-boyer.workers.dev",
    "ALLOWED_ORIGINS": "https://erik-miller-web.pages.dev,https://millerremodelingidaho.com,https://www.millerremodelingidaho.com",
    "JOBTREAD_TRANSFER_ORIGINS": "https://storage.googleapis.com,https://cdn.jobtread.com",
    "ACCESS_TEAM_DOMAIN": "weathered-wind-af3d.cloudflareaccess.com",
    "ACCESS_AUD": "aeb668870da185ca457600b8c0a45d072088cc6c648a376888016d62fe6911df",
    "OPERATOR_EMAILS": "matt.boyer@boyerimpactsystems.com,millerremodelingidaho@gmail.com",
    "GOOGLE_CLIENT_ID": "642130699967-5b5ho8d3m4usvs73v3q9b1nebul48spu.apps.googleusercontent.com",
    "GOOGLE_BOOKING_CALENDAR_ID": "millerremodelingidaho@gmail.com",
    "GOOGLE_OAUTH_REDIRECT_URI": "https://erik-miller-worker.matt-boyer.workers.dev/operator/google/callback"
  },
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "INTAKE_PHOTOS", "bucket_name": "miller-intake-photos" }],
  "d1_databases": [
    {
      "binding": "INTAKE_DB",
      "database_name": "miller-remodeling-intake",
      "database_id": "e76c0a06-6327-49ce-bc16-314a2239f58a",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INTAKE_QUEUE", "queue": "miller-intake-delivery" }
    ],
    "consumers": [
      {
        "queue": "miller-intake-delivery",
        "dead_letter_queue": "miller-intake-dead-letter",
        "max_retries": 5,
        "max_batch_size": 10
      },
      {
        "queue": "miller-intake-dead-letter",
        "max_retries": 1,
        "max_batch_size": 10
      }
    ]
  },
  "triggers": { "crons": ["0 * * * *", "*/5 * * * *"] }
}
