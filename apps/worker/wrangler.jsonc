{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "erik-miller-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "INTAKE_DB",
      "database_name": "miller-remodeling-intake",
      "database_id": "e76c0a06-6327-49ce-bc16-314a2239f58a",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INTAKE_QUEUE", "queue": "miller-intake-delivery" }
    ],
    "consumers": [
      {
        "queue": "miller-intake-delivery",
        "dead_letter_queue": "miller-intake-dead-letter",
        "max_retries": 5,
        "max_batch_size": 10
      },
      {
        "queue": "miller-intake-dead-letter",
        "max_retries": 1,
        "max_batch_size": 10
      }
    ]
  },
  "triggers": { "crons": ["0 * * * *"] }
}
