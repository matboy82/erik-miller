---
import { Image } from 'astro:assets';
import { images } from '../content/design';
const upcoming = [
  { title: 'A Bath Made for Slow Mornings', image: images.bathroom, scope: 'Bathroom remodel' },
  { title: 'Room for the Whole Family', image: images.dining, scope: 'Whole-home remodeling' },
  { title: 'A Little More Breathing Room', image: images.room, scope: 'Addition' },
  { title: 'Close to Home, All Their Own', image: images.dining, scope: 'ADU' },
  { title: 'The Heart of a Home, Reconsidered', image: images.kitchen, scope: 'Kitchen remodel' },
  { title: 'New Life in Familiar Rooms', image: images.renovation, scope: 'Whole-home remodeling' },
];
---
<section class="section-wrap"><p>Project stories and photos are coming soon.</p></section>
<section class="section-wrap story-index" aria-labelledby="stories-title"><div class="section-heading reveal"><div><p class="eyebrow">More spaces. More stories.</p><h2 id="stories-title">Homes, considered.</h2></div><p>The decisions behind the finished spaces.</p></div><div class="story-grid">{upcoming.map((project) => <article class="upcoming-card reveal"><div class="image-frame"><Image src={project.image} alt={`${project.scope} story imagery`} widths={[400, 700]} sizes="(max-width: 600px) 100vw, (max-width: 960px) 50vw, 33vw" width={700} height={525} /></div><div class="card-copy"><p class="eyebrow">Coming soon · {project.scope}</p><h3>[{project.title}]</h3></div></article>)}</div></section>
<section class="cta-band"><div class="section-wrap reveal"><p class="eyebrow">Let’s make a plan</p><h2>Your project could be next.</h2><a class="button" href="/qualify/">Start Your Project <span aria-hidden="true">↗</span></a></div></section>
