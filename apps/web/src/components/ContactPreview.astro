<section class="contact-preview" aria-labelledby="contact-title">
  <div class="contact-intro">
    <p class="eyebrow">General inquiries</p>
    <h2 id="contact-title">Let’s make room for your next chapter.</h2>
    <p>Every thoughtful remodel starts with a conversation. Tell us what works, what doesn’t, and what you’d love to change.</p>
  </div>

  <div class="contact-card" id="contact-preview" role="group" aria-describedby="demo-note">
    <p id="demo-note" class="demo-note">Use sample details. Nothing is sent or saved.</p>
    <label for="sample-name">Your name</label>
    <input id="sample-name" name="name" value="Sample Homeowner" readonly />

    <label for="sample-contact">Email or phone</label>
    <input id="sample-contact" name="contact" value="homeowner@example.invalid" readonly />
    <span class="field-hint">How can we reach you?</span>

    <label for="sample-message">What would you like help with?</label>
    <textarea id="sample-message" name="message" rows="4" readonly>We are exploring a kitchen remodel and would like to learn about the design process.</textarea>

    <div class="preview-actions" aria-label="Preview sample outcomes">
      <button type="button" class="button" data-preview="success">Preview confirmation</button>
      <button type="button" class="button button-secondary" data-preview="invalid">Preview validation</button>
    </div>
    <p class="form-status" id="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </div>
</section>

<script>
  import { initializeContactPreview } from '../scripts/contact-preview.js';
  initializeContactPreview(document);
</script>
