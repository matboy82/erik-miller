---
import { Image } from 'astro:assets';
import ServiceGrid from './ServiceGrid.astro';
import ProcessBand from './ProcessBand.astro';
import ReviewStrip from './ReviewStrip.astro';
import ContactPreview from './ContactPreview.astro';
import { images } from '../content/design';
---
<ServiceGrid />
<ProcessBand />
<section class="section-wrap proof-section" aria-labelledby="proof-title">
  <div class="section-heading reveal"><div><p class="eyebrow">The work, up close</p><h2 id="proof-title">Every detail has a reason.</h2></div><a class="text-link" href="/portfolio/">View project stories <span aria-hidden="true">↗</span></a></div>
  <a class="featured-project reveal" href="/portfolio/#morning-light">
    <div class="image-frame"><Image src={images.kitchen} alt="Kitchen with a generous island and warm wood cabinetry" widths={[600, 1000, 1600]} sizes="(max-width: 800px) 100vw, 65vw" width={1200} height={900} /></div>
    <div class="featured-copy"><p class="eyebrow">Featured project story</p><h3>A Kitchen Planned Around Morning Light</h3><p>A thoughtful layout. A place to gather. A kitchen that works as beautifully as it looks.</p><p class="project-meta">Kitchen remodel · [Project location]</p><span class="text-link">Read the story <span aria-hidden="true">↗</span></span></div>
  </a>
  <ReviewStrip />
</section>
<section class="fit-band"><div class="section-wrap reveal"><p class="eyebrow">A good fit, from the start</p><h2>Big changes.<br />Thoughtfully planned.</h2><p>Our best fits are kitchen and bath remodels and additions — projects where thoughtful design pays for itself.</p><a class="button" href="/qualify/">Find Your Project Fit <span aria-hidden="true">↗</span></a></div></section>
<div class="section-wrap"><ContactPreview /></div>
