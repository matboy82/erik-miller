---
const links = [
  { label: 'Services', href: '/#services' }, { label: 'Process', href: '/about-process/' },
  { label: 'Portfolio', href: '/portfolio/' }, { label: 'Reviews', href: '/#reviews' },
  { label: 'Contact', href: '/contact/' },
];
const current = Astro.url.pathname;
---
<nav class="site-nav" aria-label="Main navigation">
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation-links"><span class="menu-icon" aria-hidden="true"><span></span><span></span></span><span class="menu-label">Menu</span></button>
  <ul class="site-nav-list" id="navigation-links">{links.map((link) => <li><a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a></li>)}</ul>
</nav>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.querySelector<HTMLElement>('.site-nav-list');
  const close = () => { toggle?.setAttribute('aria-expanded', 'false'); links?.classList.remove('is-open'); };
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open)); links?.classList.toggle('is-open', open);
  });
  links?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
  document.addEventListener('click', (event) => { if (event.target instanceof Node && !document.querySelector('.site-header')?.contains(event.target)) close(); });
  window.matchMedia('(min-width: 1061px)').addEventListener('change', close);
</script>
