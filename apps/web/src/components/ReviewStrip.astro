---
// Real reviews and profile links remain an owner input. Do not render invented ratings or quotes.
const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL ?? '';
---
<section id="reviews" class="reviews-section" aria-labelledby="reviews-title">
  <div class="section-heading reveal"><div><p class="eyebrow">A conversation before a commitment</p><h2 id="reviews-title">Meet Erik.<br />Talk through the plan.</h2></div><p>Tell Erik what is working in your home, what isn’t, and what you want the remodel to change.</p></div>
  <a class="text-link" href="/qualify/">Start a conversation with Erik <span aria-hidden="true">↗</span></a>
  {bookingUrl && <p><a class="text-link" href={bookingUrl} target="_blank" rel="noreferrer">Schedule a job walk <span aria-hidden="true">↗</span></a></p>}
</section>
