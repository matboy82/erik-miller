---
import { copy, taglines } from '../content/brand';
import reviewScript from '../scripts/design-review.js?raw';
---
<aside class="review-toolbar" aria-label="Design review controls" data-design-review>
  <strong>DESIGN REVIEW · DRAFT</strong>
  <label>Direction
    <select id="review-theme">
      <option value="A">A · Heritage Craftsman</option>
      <option value="B">B · Modern Studio</option>
      <option value="C">C · Quiet Luxury</option>
    </select>
  </label>
  <label>Tagline
    <select id="review-tagline">
      <option value="default">Direction default</option>
      {taglines.map((tagline) => <option value={tagline}>{tagline}</option>)}
    </select>
  </label>
  <span role="status" id="review-status" class="draft">Direction A · Draft copy</span>
</aside>
<script is:inline type="application/json" id="review-copy" set:html={JSON.stringify(copy)} />
<script is:inline set:html={reviewScript} />

<style is:inline>
.review-toolbar { position: fixed; bottom: 16px; left: 16px; right: 16px; max-width: 800px; margin: auto; padding: 16px 24px; background: #1B2420; color: #fff; border: 2px solid #fff; border-radius: 6px; display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; z-index: 10; box-shadow: 0 4px 24px #0003; }
.review-toolbar select { padding: 8px; min-height: 44px; background: #fff; color: #1B2420; border-radius: 4px; }
.review-toolbar label { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1 1 180px; }
.review-toolbar select { width: 100%; min-width: 0; max-width: 100%; }
</style>
