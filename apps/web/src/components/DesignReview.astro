---
import { copy, taglines, reviewInitialDirection } from '../content/brand';
import reviewScript from '../scripts/design-review.js?raw';
const directions = { A: 'Heritage Craftsman', B: 'Modern Design-Build Studio', C: 'Quiet Luxury' };
---
<aside class="review-toolbar" aria-label="Design review controls" data-design-review>
  <strong>DESIGN REVIEW · DRAFT</strong>
  <p>Compare proposed words and styles. Erik’s final brand choice and factual claims are pending.</p>
  <label for="review-theme">Visual direction</label>
  <select id="review-theme">
    {Object.entries(directions).map(([id, label]) => <option value={id} selected={id === reviewInitialDirection}>{id} · {label}</option>)}
  </select>
  <label for="review-copy-direction">Hero and process copy</label>
  <select id="review-copy-direction">
    {Object.entries(directions).map(([id, label]) => <option value={id} selected={id === reviewInitialDirection}>{id} · {label}</option>)}
  </select>
  <label for="review-tagline">Tagline</label>
  <select id="review-tagline">
    <option value="default">Copy direction default</option>
    {Object.entries(taglines).map(([id, text]) => <option value={id}>{text}</option>)}
  </select>
  <span role="status" aria-live="polite" aria-atomic="true" id="review-status">Direction {reviewInitialDirection} · Copy {reviewInitialDirection} · Draft</span>
  <noscript>JavaScript is required to switch these draft previews. The starting direction remains readable.</noscript>
</aside>
<script is:inline type="application/json" id="review-copy" set:html={JSON.stringify({ copy, taglines }).replaceAll('<', '\u003c')} />
<script is:inline set:html={reviewScript} />
<style is:inline>
.review-toolbar { margin: 24px auto; max-width: 1072px; padding: 24px; background: #1B2420; color: #fff; border: 2px solid #fff; border-radius: 6px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
.review-toolbar p { margin: 0 0 8px; }
.review-toolbar select { width: 100%; min-width: 0; max-width: 100%; padding: 8px; min-height: 44px; background: #fff; color: #1B2420; border-radius: 4px; }
.review-toolbar :focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
.review-toolbar strong, .review-toolbar p, .review-toolbar [role="status"], .review-toolbar noscript { grid-column: 1 / -1; }
@media (min-width: 800px) { .review-toolbar { grid-template-columns: 180px minmax(0, 1fr); } }
</style>
