---
import { Image } from 'astro:assets';
import SiteNavigation from '../components/SiteNavigation.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BrandLogo from '../components/BrandLogo.astro';
import { images, services } from '../content/design';
import { brand, css } from 'virtual:miller-brand';
import '../styles/global.css';
import { pageSeo } from '../../../../scripts/site-seo.mjs';
import PageFaq from '../components/PageFaq.astro';
type PageRecord = {
  id: string; kind: string; path: string; title: string; description: string; heading: string; intro: string;
  sections: { heading: string; paragraphs: string[] }[]; processSteps?: string[];
  faqs?: { question: string; answer: string }[];
  primaryAction: { label: string; href: string }; secondaryAction?: { label: string; href: string };
};
interface Props { page: PageRecord; pages: { data: PageRecord }[]; qualification?: boolean }
const { page, qualification = false } = Astro.props as Props;
const seo = pageSeo(page, { qualification });
const schemaJson = JSON.stringify(seo.graph).replaceAll('<', '\u003c');
const home = page.id === 'home' && !qualification;
const image = services.find((service) => service.id === page.id)?.image ?? (page.id === 'process' || qualification ? images.designer : images.kitchen);
const heading = qualification ? 'Let’s find your project fit.' : page.heading;
const intro = qualification ? 'A few thoughtful questions. A clearer place to start.' : page.intro;
const eyebrow = qualification ? 'Start with a conversation' : home ? 'Treasure Valley Remodeling & Design' : page.id === 'portfolio' ? 'Project Stories' : page.id === 'process' ? 'Design before demo' : page.kind === 'area' ? 'Close to home' : page.kind === 'contact' ? 'Let’s make a plan' : 'Designed for the way you live';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1B2420" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={brand.indexed && !qualification ? 'index, follow' : 'noindex, nofollow'} />
    {!qualification && <link rel="canonical" href={seo.url} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Miller Remodeling" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.url} />
    <meta property="og:image" content={seo.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.image} />
    <meta name="twitter:image:alt" content={seo.title} />
    <script type="application/ld+json" set:html={schemaJson} />
    <meta name="description" content={seo.description} />
    <title>{seo.title}</title>
    <style is:inline set:html={css} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header">
      <BrandLogo />
      <SiteNavigation />
      <a class="button header-cta" href="/qualify/" aria-label="Start Your Project"><span class="cta-full">Start Your Project</span><span class="cta-short" aria-hidden="true">Start</span><span class="cta-arrow" aria-hidden="true">↗</span></a>
    </header>
    <main id="main" class="page-main">
      <section class:list={['page-hero', { 'home-hero': home }]} aria-labelledby="page-title">
        <Image class="hero-image" src={image} alt="" quality={65} widths={[640, 1000, 1600]} sizes="100vw" width={1600} height={1068} loading="eager" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="hero-content section-wrap">
          <p class="eyebrow">{eyebrow}</p>
          <h1 id="page-title">{heading}</h1>
          <p class="hero-intro">{intro}</p>
          {home && <><div class="hero-actions"><a class="button" href="/qualify/">Start Your Project <span aria-hidden="true">↗</span></a><a class="button button-secondary" href="/about-process/">See How We Work</a></div><div class="hero-datum"><strong>Miller / Treasure Valley, Idaho</strong><span>Plan sequence / 01–05</span></div><ol class="hero-plan"><li><span>01</span> Consult</li><li><span>02</span> Design</li><li><span>03</span> Select</li><li><span>04</span> Build</li><li><span>05</span> Walk through</li></ol></>}
        </div>
        {home && <span class="hero-footnote" aria-hidden="true">Thoughtful design. Lasting craftsmanship.</span>}
      </section>
      {!home && !qualification && <nav class="breadcrumbs" aria-label="Breadcrumb"><ol class="section-wrap"><li><a href="/">Home</a></li><li aria-current="page">{page.heading}</li></ol></nav>}
      <slot />
      {!qualification && <PageFaq faqs={page.faqs} />}
    </main>
    <SiteFooter />
    {brand.review && <span class="review-badge">REVIEW BUILD</span>}
    <script>
      const elements = document.querySelectorAll('.reveal');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
          });
        }, { threshold: 0.08 });
        elements.forEach((element) => { element.classList.add('will-reveal'); observer.observe(element); });
      }
    </script>
  </body>
</html>
